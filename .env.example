# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wordquest
TEST_DB_NAME=wordquest_agent_test

# Service Ports
FRONTEND_PORT=5174
# Optional trusted certificate paths for iPad PWA access (mounted inside frontend container).
# FRONTEND_TLS_CERT_FILE=/run/wordquest-tls/server.crt
# FRONTEND_TLS_KEY_FILE=/run/wordquest-tls/server.key
BACKEND_PORT=8010
PYTHON_PORT=8020

# AI upload and process limits
MAX_IMAGES=10
MAX_IMAGE_BYTES=5242880
MAX_TOTAL_IMAGE_BYTES=52428800
MAX_IMAGE_PIXELS=40000000
MAX_CLI_OUTPUT_BYTES=5242880

# Song learning uploads (optional; defaults to backend/uploads/songs)
SONG_UPLOAD_DIR=./uploads/songs
